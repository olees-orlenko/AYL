rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /Staff/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /News/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Regions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /Settings/contacts {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /deviceTokens/{token} {
      allow read: if false;
      allow create, update: if true;
      allow delete: if false;
    }
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /participants/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow update, delete: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid;
    }
    match /participants/{uid}/participations/{participationId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /participants/{uid}/eventSignups/{newsId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /QuizQuestions/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /PublicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /ContactRequests/{requestId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.fromUid;
      allow read: if request.auth != null && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow update: if request.auth != null && request.auth.uid == resource.data.toUid;
      allow delete: if false;
    }
    match /CertificateRequests/{requestId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.participantUid;
      allow read: if request.auth != null && (request.auth.uid == resource.data.participantUid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }
    match /News/{newsId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                && request.resource.data.authorUid == request.auth.uid
                && request.resource.data.text is string
                && request.resource.data.text.size() > 0
                && request.resource.data.text.size() <= 1000;
      allow delete: if request.auth != null
                && (resource.data.authorUid == request.auth.uid || isAdmin());
      allow update: if false;
    }
    match /CommentReports/{reportId} {
      allow create: if request.auth != null
                && request.resource.data.reportedByUid == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}