rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /participant_photos/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid + ".jpg" == fileName;
    }
    match /event_covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /event_photos/{eventId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}